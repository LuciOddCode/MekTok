<Window x:Class="MekTok.App.UI.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MekTok Quick Controls"
        Width="368"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Margin="10"
            Background="{DynamicResource SurfaceCardBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Header Row -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Keycap Emblem -->
                <Border Grid.Column="0"
                        Width="32"
                        Height="32"
                        CornerRadius="8"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4CC2FF" Offset="0" />
                            <GradientStop Color="#0067C0" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border Margin="4,3,4,5"
                            CornerRadius="4"
                            Background="#1C202A">
                        <TextBlock Text="M"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#4CC2FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MekTok"
                                   FontSize="15.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border x:Name="StatusBadge"
                                Margin="8,0,0,0"
                                Padding="8,2"
                                CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       Text="Active"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HotkeySubtitle"
                               Text="Shortcut: Ctrl+Alt+M"
                               FontSize="11"
                               Margin="0,1,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <CheckBox x:Name="MasterToggle"
                          Grid.Column="2"
                          Style="{StaticResource FluentSwitchCheckBox}"
                          VerticalAlignment="Center"
                          Checked="OnMasterToggleChanged"
                          Unchecked="OnMasterToggleChanged" />
            </Grid>

            <!-- Volume Section -->
            <Border Background="{DynamicResource SurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,9,12,8"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SpeakerMuteButton"
                                Grid.Column="0"
                                ToolTip="Mute / Unmute"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2,2,7,2"
                                Cursor="Hand"
                                Click="OnSpeakerMuteClick">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="SpeakerIconPath"
                                          Fill="{DynamicResource AccentBrush}"
                                          Data="M 3,9 L 3,15 L 7,15 L 12,19.5 L 12,4.5 L 7,9 Z" />
                                    <Path Stroke="{Binding Fill, ElementName=SpeakerIconPath}"
                                          StrokeThickness="1.9"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 15.2,8.8 C 16.7,10.3 16.7,13.7 15.2,15.2 M 18.0,6.2 C 20.6,9.0 20.6,15.0 18.0,17.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <TextBlock Grid.Column="1"
                                   Text="Volume"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock x:Name="VolumePercentText"
                                   Grid.Column="2"
                                   Text="75%"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Slider x:Name="VolumeSlider"
                            Style="{StaticResource FluentSlider}"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="1"
                            ValueChanged="OnVolumeSliderChanged" />
                </StackPanel>
            </Border>

            <!-- Switch Sound Section -->
            <Grid Margin="0,0,0,5">
                <TextBlock Text="Switch Sound"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Content="▶ Test"
                        Style="{StaticResource FluentSecondaryButton}"
                        HorizontalAlignment="Right"
                        Padding="10,4"
                        FontSize="11.5"
                        Click="OnTestSoundClick" />
            </Grid>

            <ComboBox x:Name="ProfileCombo"
                      SelectedValuePath="Id"
                      Margin="0,0,0,7"
                      SelectionChanged="OnProfileComboChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0"
                                     Width="9"
                                     Height="9"
                                     Fill="{Binding AccentHex}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Quick Switch Strip (Red, Brown, Black, Blue, Thock, Yellow) -->
            <UniformGrid x:Name="QuickSwitchesPanel"
                         Columns="3"
                         Margin="-2,0,-2,12" />

            <!-- Audio Output Device -->
            <TextBlock Text="Output Device"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,5" />
            <ComboBox x:Name="DeviceCombo"
                      SelectedValuePath="Id"
                      Margin="0,0,0,12"
                      SelectionChanged="OnDeviceComboChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Quick Realism Chips -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="KeyUpChip"
                              Grid.Column="0"
                              Content="Key-Up Sound"
                              Style="{StaticResource FluentChipToggle}"
                              Click="OnKeyUpChipClick" />
                <ToggleButton x:Name="StereoPanChip"
                              Grid.Column="2"
                              Content="Spatial Stereo"
                              Style="{StaticResource FluentChipToggle}"
                              Click="OnStereoPanChipClick" />
            </Grid>

            <!-- Open Configurator CTA -->
            <Button Content="Customize Keys &amp; Settings"
                    Style="{StaticResource FluentPrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Click="OnConfigureKeysClick" />
        </StackPanel>
    </Border>
</Window>
